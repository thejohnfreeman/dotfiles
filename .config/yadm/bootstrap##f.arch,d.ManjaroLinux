#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

# Install packages.
sudo pamac upgrade
packages=(
  base-devel
  bind
  clang
  cmake
  curl
  entr
  git
  jq
  kitty
  lua-language-server
  make
  neovim
  ninja
  nodejs
  npm
  podman
  pyright
  ripgrep
  # starpls  # Starlark language server.
  tmux
  tree
  tree-sitter-cli
  typescript-language-server
  uv
  xclip
)
sudo pamac install "${packages[@]}"

# sudo systemctl enable --now pcscd.service

uv python install
uv tool install conan
uv tool install cupcake

# Install Vim plugins.
[ -e ~/.vim/plug/autoload/plug.vim ] || git clone --depth 1 https://github.com/junegunn/vim-plug ~/.vim/plug/autoload
env --unset GIT_DIR nvim '+PlugUpdate' '+PlugClean!' '+PlugUpdate' '+qall'

# Generate an SSH key for this machine. Never copy the private half anywhere.
[ -e ~/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -C "$(whoami)@$(hostname)"
[ -z "${SSH_AUTH_SOCK:-}" ] || ssh-add ~/.ssh/id_ed25519

yadm="${HOME}/.yadm.git/yadm"
"${yadm}" remote set-url origin git@github.com:thejohnfreeman/dotfiles.git

grep -qF '~/.aliases' ~/.zshrc || cat >> ~/.zshrc <<'EOF'
source ~/.aliases
EOF
