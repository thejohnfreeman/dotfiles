#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

cd ~/.config/yadm

source liblinux.sh

export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

# Install packages.
pamac upgrade
packages=(
  base-devel
  bind
  bun
  clang
  cmake
  curl
  entr
  git
  jq
  kitty
  lua-language-server
  make
  neovim
  ninja
  podman
  pyright
  ripgrep
  # starpls  # Starlark language server.
  tmux
  tree
  tree-sitter-cli
  typescript-language-server
  uv
  xclip
)
pamac install "${packages[@]}"

# sudo systemctl enable --now pcscd.service

uv python install
uv tool install conan
uv tool install cupcake

install-vim-plugins
generate-ssh-key
configure-yadm

grep -qF '~/.aliases' ~/.zshrc || cat >> ~/.zshrc <<'EOF'
source ~/.aliases
EOF
