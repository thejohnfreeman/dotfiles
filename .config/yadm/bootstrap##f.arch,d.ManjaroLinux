#!/bin/sh

set -o errexit
set -o nounset
set -o pipefail

source liblinux.sh

# Install packages.
sudo pamac upgrade
packages=(
  bind
  clang
  cmake
  curl
  docker
  entr
  git
  jq
  kitty
  lua-language-server
  make
  neovim
  ninja
  nodejs
  npm
  pyenv
  pyright
  python-pipx
  ripgrep
  tmux
  tree
  typescript-language-server
  xclip
)
# https://github.com/pyenv/pyenv/wiki#suggested-build-environment
packages+=(
  base-devel
  openssl
  tk
  xz
  zlib
)
sudo pamac install ${packages[@]}

sudo systemctl start pcscd.service

install-python 3.12
pipx install poetry conan
install-vim-plugins
generate-ssh-key
configure-yadm

cat >>~/.zshrc <<EOF
source ~/.aliases
eval "\$(pyenv init --path)"
EOF
