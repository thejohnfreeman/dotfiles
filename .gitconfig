[alias]
  au = add --update .
  b = branch
  ba = branch --all
  c = commit
  ca = commit --amend
  cat = cat-file -p
  # cf <ancestor>
  cf = commit --fixup
  cm = commit --message
  co = checkout
  conflicts = diff --name-only --diff-filter=U --relative
  cum = commit --only . --message
  d = diff --stat
  dc = diff --cached
  dir = rev-parse --git-dir
  l = log --graph --topo-order --pretty='%C(auto)%h%d %s %Cgreen(%ar)%Creset %Cblue%an' -10
  ls = ls-files
  mc = merge --continue
  pending = "!f() { local r=$1; shift; git diff $(git merge-base HEAD $r) $@; }; f"
  rc = rebase --continue
  root = rev-parse --show-toplevel
  s = status --short
  # fixup <ancestor>
  fixup = rebase --interactive --autosquash --update-refs
  exec = "!exec "
  # count-lines <email>
  count-lines = "! git log --author=\"$1\" --pretty=tformat: --numstat | awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s, removed lines: %s, total lines: %s\\n\", add, subs, loc }' #"
[push]
  default = simple
[core]
  excludesfile = ~/.gitignore
  pager = less --quit-if-one-screen --no-init
[color]
  ui = true
[diff]
  colorMoved = default
; [rerere]
;   enabled = true
[merge]
  ff = false
[pull]
  ff = only
[rebase]
  autoSquash = true
[init]
  defaultBranch = master
[help]
  autocorrect = -1
[color "branch"]
  current = green reverse
  local = cyan
  remote = white
[color "diff"]
  new = brightgreen italic
  old = red strike
  newMoved = cyan
  oldMoved = cyan dim
  newMovedAlternative = magenta
  oldMovedAlternative = magenta dim
[color "status"]
  changed = brightyellow
  added  = brightcyan
[include]
  # A missing file is ignored.
  path = .gitconfig.local
